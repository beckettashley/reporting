{
  "$schema": "../theme-schema.json",
  "$comment": "ADAPTED from beckettashley/component-demo @ 1b73a46 with local primitive rename to use semantic role names. Eventual reconciliation between repos pending.",
  "baseFontSize": 16,
  "colors": {
    "primitives": {
      "background": "#FFFFFF",
      "backgroundDark": "#5C1A1A",
      "foreground": "#1A1A1A",
      "foregroundDark": "#FFFFFF",
      "muted": "#F4E8D8",
      "mutedDark": "#A85F2F",
      "mutedForeground": "#666666",
      "mutedForegroundDark": "#E5E7EB",
      "primary": "#D97A3E",
      "primaryDark": "#FFB347",
      "primaryForeground": "#FFFFFF",
      "primaryForegroundDark": "#1A1A1A",
      "brandSubtle": "#FAEBE0",
      "brandSubtleForeground": "#1A1A1A",
      "warning": "#FEF9C3",
      "warningForeground": "#1A1A1A",
      "textBrand": "#D97A3E",
      "textBrandDark": "#FFB347",
      "link": "#D97A3E",
      "linkDark": "#FFFFFF",
      "textAlert": "#DC2626",
      "border": "#E5E7EB",
      "ring": "#D97A3E",
      "ringDark": "#FFB347",
      "cta": "#FFB347",
      "ctaForeground": "#1A1A1A",
      "ctaBorder": "#DE9B3D",
      "ctaHover": "#FAAF45"
    },
    "semantic": {
      "light": {
        "background": "background",
        "foreground": "foreground",
        "muted": "muted",
        "mutedForeground": "mutedForeground",
        "primary": "primary",
        "primaryForeground": "primaryForeground",
        "brandSubtle": "brandSubtle",
        "brandSubtleForeground": "brandSubtleForeground",
        "warning": "warning",
        "warningForeground": "warningForeground",
        "textBrand": "textBrand",
        "link": "link",
        "textAlert": "textAlert",
        "border": "border",
        "ring": "ring",
        "cta": "cta",
        "ctaForeground": "ctaForeground",
        "ctaBorder": "ctaBorder",
        "ctaHover": "ctaHover"
      },
      "dark": {
        "background": "backgroundDark",
        "foreground": "foregroundDark",
        "muted": "mutedDark",
        "mutedForeground": "mutedForegroundDark",
        "primary": "primaryDark",
        "primaryForeground": "primaryForegroundDark",
        "textBrand": "textBrandDark",
        "link": "linkDark",
        "ring": "ringDark"
      }
    },
    "pairs": {
      "background": { "onSurface": "light" },
      "backgroundDark": { "onSurface": "dark" },
      "foreground": { "onSurface": "dark" },
      "foregroundDark": { "onSurface": "light" },
      "muted": { "onSurface": "light" },
      "mutedDark": { "onSurface": "dark" },
      "mutedForeground": { "onSurface": "dark" },
      "mutedForegroundDark": { "onSurface": "light" },
      "primary": { "onSurface": "dark" },
      "primaryDark": { "onSurface": "light" },
      "primaryForeground": { "onSurface": "light" },
      "primaryForegroundDark": { "onSurface": "dark" },
      "brandSubtle": { "onSurface": "light" },
      "brandSubtleForeground": { "onSurface": "dark" },
      "warning": { "onSurface": "light" },
      "warningForeground": { "onSurface": "dark" },
      "textBrand": { "onSurface": "dark" },
      "textBrandDark": { "onSurface": "light" },
      "link": { "onSurface": "dark" },
      "linkDark": { "onSurface": "light" },
      "textAlert": { "onSurface": "dark" },
      "border": { "onSurface": "light" },
      "ring": { "onSurface": "dark" },
      "ringDark": { "onSurface": "light" },
      "cta": { "onSurface": "light" },
      "ctaForeground": { "onSurface": "dark" },
      "ctaBorder": { "onSurface": "dark" },
      "ctaHover": { "onSurface": "light" }
    },
    "gradients": {
      "subtle": {
        "surface": "light",
        "midStopHex": "#FCF1E9"
      }
    }
  },
  "typography": {
    "title": {
      "family": "'Archivo', sans-serif",
      "weight": 900,
      "lineHeight": 1.05,
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "'Archivo', sans-serif",
      "weight": 800,
      "lineHeight": 1.155,
      "letterSpacing": "-0.025em"
    },
    "h2": {
      "family": "'Archivo', sans-serif",
      "weight": 900,
      "lineHeight": 1.2,
      "letterSpacing": "-0.015em"
    },
    "h3": {
      "family": "'Archivo', sans-serif",
      "weight": 700,
      "lineHeight": 1.25,
      "letterSpacing": "-0.01em"
    },
    "h4": {
      "family": "'Archivo', sans-serif",
      "weight": 800,
      "lineHeight": 1.3,
      "letterSpacing": "-0.005em"
    },
    "h5": {
      "family": "'Archivo', sans-serif",
      "weight": 700,
      "lineHeight": 1.4,
      "letterSpacing": "0"
    },
    "h6": {
      "family": "'Archivo', sans-serif",
      "weight": 700,
      "lineHeight": 1.4,
      "letterSpacing": "0"
    },
    "body": {
      "family": "'Lato', sans-serif",
      "weight": 400,
      "lineHeight": 1.6,
      "letterSpacing": "0"
    },
    "ui": {
      "family": "'Lato', sans-serif",
      "weight": 700,
      "lineHeight": 1.4,
      "letterSpacing": "0.01em"
    },
    "condensed": {
      "family": "'Barlow', sans-serif",
      "weight": 900,
      "lineHeight": 1.155,
      "letterSpacing": "-0.025em"
    },
    "accordionQuestion": {
      "family": "'Lato', sans-serif",
      "weight": 700,
      "lineHeight": 1.4,
      "letterSpacing": "0"
    },
    "meta": {
      "family": "'Lato', sans-serif",
      "weight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "0"
    },
    "muted": {
      "color": "mutedForeground"
    }
  },
  "brandAssets": {
    "logo": {
      "light": "https://placeholder.example.com/solstice-logo-light.svg",
      "dark": "https://placeholder.example.com/solstice-logo-dark.svg"
    }
  }
}
